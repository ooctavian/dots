set $term alacritty
set $cursor_size 12
set $locker ~/.local/bin/lock
set $exit i3-msg exit
set $restart restart
set $msg i3-msg
set $app class
set $popup instance
set $scratch_term alacritty --class=popup_term -e tmux new -As scratchpad
set $scratch_term_new alacritty --class=popup_term -T scratchpad-new -e tmux new -As scratchpad

include ~/.config/wm/common.conf

exec --no-startup-id autorandr --change
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id xsetroot -cursor_name left_ptr
exec_always --no-startup-id hsetroot -cover ~/.config/wm/wall.jpg

exec --no-startup-id xset s 600 dpms 0 0 900
exec --no-startup-id ~/.local/bin/lock --prepare
exec --no-startup-id picom

exec_always --no-startup-id setxkbmap -layout "ro,ru" -option "grp:shift_caps_toggle,ctrl:nocaps"

# --- Screenshots ---
bindsym Print exec env LC_ALL=en_US.UTF-8 flameshot gui

# --- Bar ---
bar {
    # position top
    position bottom
    status_command ~/.local/bin/i3status-wrapper.sh
    font pango:Adwaita Mono, Symbols Nerd Font 10
    workspace_min_width 60
    padding 0px
    tray_padding 0

    colors {
        background #000000
        # separator  #000000
        statusline #FFFFFF
        separator  #c1c1c1

        focused_workspace  #303030 #303030 #FFFFFF
        active_workspace   #212121 #212121 #FFFFFF
        inactive_workspace #212121 #212121 #C1C1C1
        urgent_workspace   #212121 #424242 #FFFFFF
        binding_mode       #212121 #424242 #FFFFFF
        }
}

exec --no-startup-id nm-applet
exec --no-startup-id udiskie --automount --notify --tray
exec --no-startup-id xfce4-power-manager
exec --no-startup-id sh -c 'i3-msg "workspace 1; append_layout ~/.config/i3/workspace_1.json" && { emacs & alacritty -e tmux new -As main & }'

exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lock-screen-suspend-hibernate -n -t bool -s true
exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/inactivity-on-battery -n -t uint -s 5
exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/inactivity-on-ac -n -t uint -s 10
exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/inactivity-sleep-mode-on-battery -n -t uint -s 1
exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/inactivity-sleep-mode-on-ac -n -t uint -s 1
exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lid-action-on-battery -n -t uint -s 1
exec_always --no-startup-id xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lid-action-on-ac -n -t uint -s 1
