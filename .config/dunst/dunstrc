[global]
    monitor = 0
    follow = mouse
    geometry = "350x10-20+50"
    indicate_hidden = true
    shrink = true

    transparency = 0
    frame_width = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    line_height = 0
    corner_radius = 4

    font = monospace 11

    # Colors match your i3 theme
    background = "#212121"
    foreground = "#FFFFFF"
    separator_color = auto

    icon_theme = Adwaita
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 32

    idle_threshold = 120
    markup = full
    alignment = center
    ellipsize = end

    show_indicators = yes
    word_wrap = yes

    # History
    history_length = 20

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action


[urgency_low]
    background = "#212121"
    foreground = "#C1C1C1"
    timeout = 4

[urgency_normal]
    background = "#303030"
    foreground = "#FFFFFF"
    timeout = 8

[urgency_critical]
    background = "#424242"
    foreground = "#FFFFFF"
    frame_width = 2
    timeout = 0
