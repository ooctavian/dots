#!/bin/sh

pidfile="${XDG_RUNTIME_DIR:-/tmp}/recordingpid"

if [ -f "$pidfile" ]; then
    pid=$(cat "$pidfile")
    rm -f "$pidfile"
    kill -INT "$pid" 2>/dev/null
    while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
    pkill -USR1 -x i3status
    notify-send "record" "Recording stopped"
    exit 0
fi

dir=$(xdg-user-dir VIDEOS 2>/dev/null) || dir="$HOME/Videos"
[ -n "$dir" ] && [ "$dir" != "$HOME" ] || dir="$HOME/Videos"
mkdir -p "$dir"
name="$dir/Recording_$(date +'%Y-%m-%d_%H-%M-%S').mp4"

choice=$(printf 'Full\nArea\nExit\n' | rofi -dmenu -p record) || exit 0

if [ -n "$WAYLAND_DISPLAY" ]; then
    case $choice in
        Full)
            output=$(swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.focused) | .name')
            set -- ${output:+-o "$output"}
            ;;
        Area)
            geometry=$(slurp) || exit 1
            set -- -g "$geometry"
            ;;
        *) exit 0 ;;
    esac
    wf-recorder "$@" -c h264_vaapi -d /dev/dri/renderD128 -f "$name" >/dev/null 2>&1 &
else
    case $choice in
        Full)
            res=$(xdpyinfo | sed -n 's/.*dimensions: *\([0-9]*x[0-9]*\).*/\1/p')
            set -- -video_size "$res" -i "$DISPLAY"
            ;;
        Area)
            area=$(slop -f '%wx%h %x,%y') || exit 1
            set -- -video_size "${area% *}" -i "$DISPLAY+${area#* }"
            ;;
        *) exit 0 ;;
    esac
    ffmpeg -loglevel error -framerate 30 -f x11grab "$@" "$name" &
fi

echo $! > "$pidfile"
pkill -USR1 -x i3status
notify-send "record" "Recording to ${name##*/}"
