#!/usr/bin/env bash
#: yuune i3lock-color wrapper

wallpaper="$HOME/.config/wm/wall.jpg"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/lock"
mkdir -p "$cache"
tmpwall="$cache/lock.png"
wppath="$cache/lock-wppath"

read -r WIDTH HEIGHT < <(xrandr --current | awk '/ connected primary/ { split($4, g, /[x+]/); print g[1], g[2]; exit }')
: "${WIDTH:=1920}" "${HEIGHT:=1080}"

genwp() {
	local key="$wallpaper $(stat -c %Y "$wallpaper") ${WIDTH}x${HEIGHT}"
	if [[ ! -f "$wppath" || "$key" != "$(cat "$wppath")" ]]; then
		rm -f "$tmpwall"
	fi

	if [[ ! -f $tmpwall ]]; then
		magick "$wallpaper" -resize "${WIDTH}x${HEIGHT}^" -gravity center -extent "${WIDTH}x${HEIGHT}" +repage \( \
			-size 120x140 xc:none \
			-draw "roundrectangle 0,0,120,140,20,20" \
			-draw "rectangle 0,140 120,120" -normalize +level 0,50% \
			\) -gravity south -compose over -composite \
			-define png:compression-level=1 "png:$tmpwall.tmp" &&
			mv "$tmpwall.tmp" "$tmpwall" && echo "$key" >"$wppath"
	fi
}

if [[ $1 == --prepare ]]; then
	genwp
	exit
fi

runlock() {
	i3lock -e -f --clock -i "$tmpwall" \
		--ind-pos="w/2:h-80" --time-pos="w/2:h/2" \
		--insidever-color=00000000 --insidewrong-color=00000000 --inside-color=00000000 \
		--ringver-color=b2ebf2FF --ringwrong-color=e95678FF --ring-color=cbced0FF \
		--keyhl-color=21bfc295 --bshl-color=e9567895 --separator-color=00000000 \
		--layout-color=00000000 \
		--line-uses-ring \
		--time-str="%H:%M" \
		--time-color=fdf0edFF \
		--time-font="BlexMono Nerd Font" \
		--time-size=80 \
		--date-str="%A, %b %d" \
		--date-color=fdf0edFF \
		--date-font="BlexMono Nerd Font" \
		--date-size=16 \
		--radius 30 --ring-width 5 \
		--indicator \
		--verif-text="" \
		--wrong-text="" \
		--noinput-text=""
}

genwp && runlock
